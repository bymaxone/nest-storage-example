{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "plugins": ["@stryker-mutator/jest-runner", "@stryker-mutator/typescript-checker"],
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.stryker.config.cjs",
    "enableFindRelatedTests": true
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.module.ts",
    "!src/**/dto/**",
    "!src/main.ts",
    "!src/**/*.d.ts"
  ],
  "thresholds": { "high": 100, "low": 100, "break": 100 },
  "incremental": true,
  "incrementalFile": ".stryker-tmp/incremental-api.json",
  "concurrency": 2,
  "reporters": ["html", "json", "clear-text", "progress"],
  "htmlReporter": { "fileName": "reports/mutation/api.html" },
  "jsonReporter": { "fileName": "reports/mutation/api.json" },
  "clearTextReporter": { "maxTestsToLog": 3 },
  "timeoutMS": 30000,
  "disableTypeChecks": true
}
