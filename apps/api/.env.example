# Environment template for the nest-storage-example API.
# Copy to `.env` and adjust as needed; the committed defaults target the local
# MinIO stack from docker-compose.yml. Dev credentials only, never real keys.
# Every variable is Zod-validated at boot in src/config/env.schema.ts.

# Runtime mode: switches pretty error output and scanner defaults.
NODE_ENV=development
# Port the API listens on.
PORT=3001
# Allowed browser origin for CORS (the web dashboard).
WEB_ORIGIN=http://localhost:3000

# S3-compatible endpoint of the MinIO server.
STORAGE_ENDPOINT=http://localhost:9000
# Region label; MinIO accepts any value.
STORAGE_REGION=us-east-1
# Default bucket for all primary demos.
STORAGE_BUCKET=vault
# Target bucket for cross-bucket copy operations.
STORAGE_ARCHIVE_BUCKET=vault-archive
# Bucket with versioning enabled for the version-download demo.
STORAGE_VERSIONED_BUCKET=vault-versioned
# Access key id (dev credentials only, never real keys).
STORAGE_ACCESS_KEY_ID=minioadmin
# Secret access key (dev credentials only, never real keys).
STORAGE_SECRET_ACCESS_KEY=minioadmin
# Use path-style addressing, required by MinIO.
STORAGE_FORCE_PATH_STYLE=true
# Base URL used to build unsigned public object URLs.
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/vault
# When set, getPublicUrl switches to this CDN base instead of the public one.
STORAGE_CDN_BASE_URL=
# Global instance key prefix applied to every object key.
STORAGE_KEY_PREFIX=storage-example
# Server-side encryption; set to AES256 to enable global SSE (SSE-S3 on MinIO needs KMS).
STORAGE_SSE=
# Checksum mode; WHEN_REQUIRED opts out of the SDK default CRC32 headers that MinIO rejects.
STORAGE_CHECKSUM_MODE=WHEN_REQUIRED
# Signed-URL TTL cap in seconds; low enough to make the clamp demo visible.
STORAGE_MAX_TTL_SECONDS=3600
# Byte size above which uploads switch to multipart (5 MiB).
STORAGE_MULTIPART_THRESHOLD=5242880
# Scanner lab default mode: pre-upload or post-upload.
SCANNER_MODE=pre-upload
# Scanner lab default: reject uploads whose scan verdict is inconclusive.
SCANNER_REJECT_ON_UNKNOWN=false
# Maximum accepted upload size in bytes for the validation cap (25 MiB).
UPLOAD_MAX_SIZE_BYTES=26214400
